#!/usr/bin/env bash
# Manage the project-local automatic Omarchy plugin synchronizer.
#
# Usage:
#   ./scripts/manage-watcher start
#   ./scripts/manage-watcher stop
#   ./scripts/manage-watcher restart
#   ./scripts/manage-watcher enable
#   ./scripts/manage-watcher disable
#   ./scripts/manage-watcher status
#
# This script determines both the current user and the project root at runtime.
# It may therefore be run from any directory and continues to work if this
# repository is cloned somewhere other than ~/dicey-kustomarchy.
#
# `start` begins watching for this login session. `enable` also starts it and
# makes it return on future logins. `disable` stops it and removes that
# persistent startup setting. Generated units are user units: no sudo needed.

set -euo pipefail

action=${1:-}
project_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
current_user=$(id -un)
current_home=$(getent passwd "$current_user" | awk -F: '{print $6}')
unit_dir="$current_home/.config/systemd/user"
unit_name="dicey-kustomarchy-sync"
path_unit="$unit_dir/$unit_name.path"
service_unit="$unit_dir/$unit_name.service"
sync_script="$project_root/scripts/sync-plugins"

usage() {
  echo "Usage: $(basename "$0") {start|stop|restart|enable|disable|status}" >&2
  exit 2
}

[[ -x $sync_script ]] || {
  echo "Missing executable synchronizer: $sync_script" >&2
  exit 1
}

install_units() {
  mkdir -p "$unit_dir"

  # systemd's command parser accepts a quoted executable path. Escape the two
  # characters that matter inside those quotes so relocated clones still work.
  escaped_sync=${sync_script//\\/\\\\}
  escaped_sync=${escaped_sync//\"/\\\"}

  cat >"$service_unit" <<EOF
# Generated by $project_root/scripts/manage-watcher for user $current_user.
# Re-run the manager after moving this checkout to regenerate the absolute path.
[Unit]
Description=Synchronize dicey-kustomarchy Omarchy plugins

[Service]
Type=oneshot
ExecStart="$escaped_sync"
EOF

  cat >"$path_unit" <<EOF
# Generated by $project_root/scripts/manage-watcher for user $current_user.
# PathModified watches the project plugin tree; the paired service validates
# each changed plugin before making it live.
[Unit]
Description=Watch dicey-kustomarchy plugins for changes

[Path]
PathModified=$project_root/plugins
Unit=$unit_name.service

[Install]
WantedBy=default.target
EOF

  systemctl --user daemon-reload
}

case $action in
  start)
    install_units
    systemctl --user start "$unit_name.path"
    ;;
  stop)
    systemctl --user stop "$unit_name.path"
    ;;
  restart)
    install_units
    systemctl --user restart "$unit_name.path"
    ;;
  enable)
    install_units
    systemctl --user enable --now "$unit_name.path"
    ;;
  disable)
    systemctl --user disable --now "$unit_name.path"
    ;;
  status)
    systemctl --user status "$unit_name.path"
    ;;
  *) usage ;;
esac
