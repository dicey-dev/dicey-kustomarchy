#!/usr/bin/env bash
set -euo pipefail

plugin_id=${1:?usage: scripts/install-plugin <plugin-id>}
project_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source_dir="$project_root/plugins/$plugin_id"
target_dir="$HOME/.config/omarchy/plugins/$plugin_id"

[[ -d $source_dir ]] || { echo "Unknown tracked plugin: $plugin_id" >&2; exit 2; }
mkdir -p "$HOME/.config/omarchy/plugins"

if [[ -e $target_dir || -L $target_dir ]]; then
  stamp=$(date +%Y%m%d%H%M%S)
  backup_dir="${target_dir}.backup-${stamp}"
  mv "$target_dir" "$backup_dir"
  echo "Backed up existing plugin to $backup_dir"
fi

cp -a "$source_dir" "$target_dir"
omarchy plugin validate "$target_dir"
omarchy-shell shell rescanPlugins
echo "Installed $plugin_id to $target_dir"
